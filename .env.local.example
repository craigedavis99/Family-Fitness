# Supabase — add these after creating your project at supabase.com
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used for admin user creation (Phase 2). Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — this email is always promoted to admin on sign-in (same login as members).
INITIAL_ADMIN_EMAIL=craig.e.davis@gmail.com
